# Copy this file to .streamlit/secrets.toml and fill in your values.
# The real secrets.toml is git-ignored — never commit real keys.
#
# On Streamlit Community Cloud you don't use this file: paste the same
# key = "value" lines into the app's Settings -> Secrets box instead.

# Required: the SEC EDGAR API rejects requests without a User-Agent that
# identifies who is making them (your name + a contact email).
SEC_USER_AGENT = "Your Name your-email@example.com"

# Required for the hosted demo (no local GPU). Get a free key at
# https://console.groq.com/keys
GROQ_API_KEY = "gsk_your_key_here"

# Optional overrides:
# LLM_PROVIDER = "groq"                      # force "ollama" or "groq" (default: auto-detect)
# GROQ_MODEL   = "llama-3.3-70b-versatile"   # any tool-capable open-weight model on Groq
# OLLAMA_MODEL = "qwen2.5:14b"               # local model when Ollama is running
