# Copy this file to .env and fill in your details.

# The SEC EDGAR API requires a User-Agent that identifies who is making the
# request: your name (or app name) and a contact email. Do NOT commit a real
# email — .env is gitignored; this .example file is the only one tracked.
SEC_USER_AGENT=Your Name your-email@example.com

# Optional: override the local Ollama model (default: qwen2.5:14b).
# OLLAMA_MODEL=qwen2.5:14b

# Hosted fallback (used automatically when no local Ollama server is running,
# e.g. on Streamlit Community Cloud). Get a free key at
# https://console.groq.com/keys. For the Streamlit app, prefer putting this in
# .streamlit/secrets.toml instead of .env.
# GROQ_API_KEY=gsk_your_key_here
# LLM_PROVIDER=groq            # force a backend; default auto-detects
# GROQ_MODEL=llama-3.3-70b-versatile
