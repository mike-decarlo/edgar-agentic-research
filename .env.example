# Copy this file to .env and fill in your details.

# The SEC EDGAR API requires a User-Agent that identifies who is making the
# request: your name (or app name) and a contact email. Do NOT commit a real
# email — .env is gitignored; this .example file is the only one tracked.
SEC_USER_AGENT=Your Name your-email@example.com

# Optional: override the local Ollama model (default: qwen2.5:14b).
# OLLAMA_MODEL=qwen2.5:14b
